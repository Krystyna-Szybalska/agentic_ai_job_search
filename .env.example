# LLM model served by Ollama
# Supported models: phi3:mini, phi4-mini, qwen3:4b, qwen3:8b, gemma3:4b, llama3.1:8b
# Thinking models (qwen3) automatically get higher token budgets.
OLLAMA_MODEL=phi3:mini

# Sentence-transformers embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector search settings
TOP_K=5
TOP_N_FOR_CRITIC=3

# Paths
VECTOR_STORE_PATH=vector_store/
JOBS_DATA_PATH=data/processed/jobs_dataset.json
OUTPUTS_DIR=outputs/

# Set to 1 to disable downloading models from HuggingFace Hub
HF_HUB_OFFLINE=1

# Job source: "local" (FAISS vector store) or "remotive" (Remotive API)
JOB_SOURCE=local

# Remotive API settings (only used when JOB_SOURCE=remotive)
REMOTIVE_SEARCH=python developer
REMOTIVE_LIMIT=20
